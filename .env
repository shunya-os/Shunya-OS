# Shunya OS — Production Environment Variables
# Copy required values. Secrets marked [REQUIRED] must be filled in.

SECRET_KEY=shunya-club-secret-key-2024
FLASK_ENV=production
LOG_LEVEL=INFO

# Database (default password is "shunya" — change if different)
DB_PASSWORD=shunya

# AI / LLM Provider
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Payments [REQUIRED for live payments]
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# WhatsApp [REQUIRED for WhatsApp integration]
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=

# Telegram [REQUIRED for Telegram bot]
# TELEGRAM_BOT_TOKEN=

# Email / SMTP [REQUIRED for email notifications]
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@panchi.club

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
WORKERS=4