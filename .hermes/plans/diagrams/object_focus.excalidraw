    { "type": "rectangle", "id": "shell", "x": 80, "y": 80, "width": 680, "height": 480, "roundness": { "type": 3 }, "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeColor": "#dee2e6", "strokeWidth": 1 },

    { "type": "rectangle", "id": "header", "x": 100, "y": 100, "width": 640, "height": 40, "roundness": { "type": 3 }, "backgroundColor": "#e9ecef", "fillStyle": "solid", "boundElements": [{ "id": "t_header", "type": "text" }] },
    { "type": "text", "id": "t_header", "x": 120, "y": 107, "width": 600, "height": 25, "text": "\u2190 Acme Corp         [Strategy]  [Active]  [\u22ef]", "fontSize": 16, "fontFamily": 1, "strokeColor": "#495057", "textAlign": "left", "verticalAlign": "middle", "containerId": "header", "originalText": "\u2190 Acme Corp         [Strategy]  [Active]  [\u22ef]", "autoResize": true },

    { "type": "text", "id": "obj_name", "x": 120, "y": 160, "width": 600, "height": 35, "text": "Q3 Strategy Proposal", "fontSize": 28, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "Q3 Strategy Proposal", "autoResize": true },

    { "type": "rectangle", "id": "content", "x": 120, "y": 210, "width": 600, "height": 80, "roundness": { "type": 3 }, "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeColor": "#dee2e6", "boundElements": [{ "id": "t_content", "type": "text" }] },
    { "type": "text", "id": "t_content", "x": 140, "y": 220, "width": 560, "height": 60, "text": "A comprehensive strategy for Q3 focusing on\nmarket expansion, team growth, and product\ninnovation.  [click to edit]", "fontSize": 14, "fontFamily": 1, "strokeColor": "#495057", "textAlign": "left", "verticalAlign": "top", "containerId": "content", "originalText": "A comprehensive strategy for Q3 focusing on\nmarket expansion, team growth, and product\ninnovation.  [click to edit]", "autoResize": true },

    { "type": "text", "id": "sec_rel", "x": 120, "y": 310, "width": 200, "height": 20, "text": "\u2500\u2500\u2500\u2500  Relationships  \u2500\u2500\u2500\u2500", "fontSize": 14, "fontFamily": 1, "strokeColor": "#868e96", "originalText": "\u2500\u2500\u2500\u2500  Relationships  \u2500\u2500\u2500\u2500", "autoResize": true },
    { "type": "text", "id": "rel_items", "x": 140, "y": 335, "width": 400, "height": 40, "text": "\u25cb Rahul (Contact)    \u25cb Acme Corp (Organization)\n\u25cb Q3 Budget (Object)  \u25cb Alice (Creator)", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "\u25cb Rahul (Contact)    \u25cb Acme Corp (Organization)\n\u25cb Q3 Budget (Object)  \u25cb Alice (Creator)", "autoResize": true },

    { "type": "text", "id": "sec_conv", "x": 120, "y": 390, "width": 200, "height": 20, "text": "\u2500\u2500\u2500\u2500  Conversations  \u2500\u2500\u2500\u2500", "fontSize": 14, "fontFamily": 1, "strokeColor": "#868e96", "originalText": "\u2500\u2500\u2500\u2500  Conversations  \u2500\u2500\u2500\u2500", "autoResize": true },
    { "type": "text", "id": "conv_items", "x": 140, "y": 415, "width": 400, "height": 40, "text": "\u25cb \"Can we review the budget allocation?\" \u2014 2h ago\n\u25cb \"Timeline looks good\" \u2014 yesterday", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "\u25cb \"Can we review the budget allocation?\" \u2014 2h ago\n\u25cb \"Timeline looks good\" \u2014 yesterday", "autoResize": true },

    { "type": "text", "id": "sec_ai", "x": 120, "y": 470, "width": 200, "height": 20, "text": "\u2500\u2500\u2500\u2500  AI Understanding  \u2500\u2500\u2500\u2500", "fontSize": 14, "fontFamily": 1, "strokeColor": "#868e96", "originalText": "\u2500\u2500\u2500\u2500  AI Understanding  \u2500\u2500\u2500\u2500", "autoResize": true },
    { "type": "text", "id": "ai_text", "x": 140, "y": 495, "width": 500, "height": 40, "text": "This strategy has been reviewed by 3 people.\nThe next step is budget approval. Rahul is waiting.", "fontSize": 14, "fontFamily": 1, "strokeColor": "#5c7cfa", "originalText": "This strategy has been reviewed by 3 people.\nThe next step is budget approval. Rahul is waiting.", "autoResize": true },

    { "type": "text", "id": "note", "x": 200, "y": 580, "width": 500, "height": 40, "text": "Everything else quietly fades. The object is the center.\n70% whitespace. 20% context. 10% interaction.", "fontSize": 14, "fontFamily": 1, "strokeColor": "#868e96", "textAlign": "center", "originalText": "Everything else quietly fades. The object is the center.\n70% whitespace. 20% context. 10% interaction.", "autoResize": true }
