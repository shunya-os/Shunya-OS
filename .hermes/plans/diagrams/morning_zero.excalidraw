    { "type": "rectangle", "id": "item1", "x": 100, "y": 150, "width": 600, "height": 50, "roundness": { "type": 3 }, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{ "id": "t_item1", "type": "text" }] },
    { "type": "text", "id": "t_item1", "x": 120, "y": 157, "width": 560, "height": 35, "text": "\u25cf  Rahul's proposal is waiting for approval  \u2014  2 days remaining", "fontSize": 15, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "left", "verticalAlign": "middle", "containerId": "item1", "originalText": "\u25cf  Rahul's proposal is waiting for approval  \u2014  2 days remaining", "autoResize": true },

