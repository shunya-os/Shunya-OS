    { "type": "text", "id": "opp_title", "x": 100, "y": 355, "width": 400, "height": 20, "text": "2 opportunities observed:", "fontSize": 16, "fontFamily": 1, "strokeColor": "#868e96", "originalText": "2 opportunities observed:", "autoResize": true },

    { "type": "rectangle", "id": "item4", "x": 100, "y": 385, "width": 600, "height": 50, "roundness": { "type": 3 }, "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeColor": "#dee2e6", "boundElements": [{ "id": "t_item4", "type": "text" }] },
