    { "type": "text", "id": "t_item2", "x": 120, "y": 222, "width": 560, "height": 35, "text": "\u25cb  Q3 Strategy \u2014 3 new messages  \u2014  \"Can we review the budget?\"", "fontSize": 15, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "left", "verticalAlign": "middle", "containerId": "item2", "originalText": "\u25cb  Q3 Strategy \u2014 3 new messages  \u2014  \"Can we review the budget?\"", "autoResize": true },

