# Shunya OS environment variables
# Copy this file to .env and fill in values
# Never commit .env to git

SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=production
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shunya

# Optional: AI / External services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WHATSAPP_API_TOKEN=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@panchi.club

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
WORKERS=4